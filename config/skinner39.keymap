#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp COMMA    &kp PERIOD  &kp U           &kp L        &kp P                                         &kp J       &kp W        &kp R       &kp Y  &kp ESCAPE
  &mt LSHFT E  &kp I       &mt LEFT_ALT A  &mt LCTRL O  &mt LGUI MINUS                                &mt RGUI K  &mt RCTRL N  &mt RALT N  &kp S  &mt RSHIFT H
  &kp Q        &kp X       &kp C           &kp V        &kp F                                         &kp G       &kp D        &kp M       &kp Z  &kp B
  &mkp LCLK    &mkp MCLK   &mkp RCLK       &lt 1 ENTER  &lt 2 SPACE     &mt LSHFT TAB  &kp BACKSPACE  &lt 4 DEL                                   &kp RIGHT_SHIFT
            >;
        };

        number_layer {
            bindings = <
  &kp F1        &kp F2   &kp F3       &kp F4        &kp F5                           &kp COLON           &kp NUMBER_7        &kp NUMBER_8  &kp NUMBER_9  &trans
  &mt LSHFT F6  &kp F7   &mt LALT F8  &mt LCTRL F9  &mt LGUI F10                     &mt RGUI SEMICOLON  &mt RCTRL NUMBER_4  &mt RALT N5   &kp NUMBER_6  &trans
  &kp F11       &kp F12  &kp F13      &kp F14       &kp PRINTSCREEN                  &kp N0              &kp NUMBER_1        &kp N2        &kp NUMBER_3  &trans
  &trans        &trans   &trans       &trans        &trans           &trans  &trans  &trans                                                              &trans
            >;
        };

        symbol_layer {
            bindings = <
  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH                &kp DOLLAR       &kp PERCENT                     &kp CARET       &kp AMPERSAND    &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
  &trans           &trans       &mt LEFT_ALT BACKSLASH  &mt LCTRL SLASH  &mt LGUI GRAVE                  &mt RGUI MINUS  &mt RCTRL EQUAL  &mt RALT SQT       &kp LEFT_BRACKET      &mt RSHFT RIGHT_BRACKET
  &trans           &trans       &kp PIPE                &kp QUESTION     &kp TILDE                       &kp UNDERSCORE  &kp PLUS         &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE
  &trans           &trans       &trans                  &trans           &trans          &trans  &trans  &trans                                                                    &trans
            >;
        };

        function_layer {
            bindings = <
  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &trans  &trans  &trans  &trans  &trans
  &kp F5  &kp F6   &kp F7   &kp F8   &trans                  &trans  &trans  &trans  &trans  &trans
  &kp F9  &kp F10  &kp F11  &kp F12  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                          &trans
            >;
        };

        mouse_layer {
            bindings = <
  &trans          &mmv MOVE_UP    &trans          &msc SCRL_UP    &trans                           &trans          &trans         &trans        &trans     &trans
  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT                  &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
  &trans          &trans          &trans          &msc SCRL_DOWN  &trans                           &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &trans
  &trans          &trans          &trans          &trans          &trans           &trans  &trans  &trans                                                  &trans
            >;
        };

        scroll_layer {
            bindings = <
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            bindings = <
  &trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };

        customizable_layer {
            bindings = <
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };
    };
};
